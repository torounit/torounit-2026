                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "FrHDa",
                  "name": "Paragraph",
                  "fill": "$color-contrast",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Twitter でも書きましたが、トップレベルにはグループブロックが必要です。基本的にはグループブロックがサイトの横幅を制御しています。CSS とかで横幅の制御を自前でやっても管理画面では崩れたり、幅広や全幅が正しく動作しなかったりします。",
                  "lineHeight": 1.75,
                  "fontFamily": "$font-family-zen-kaku-gothic-new",
