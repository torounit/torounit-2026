                  "fill": "$color-contrast",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "テンプレートのトップレベルには、グループブロックを配置しその中に要素を設置する。",
                  "lineHeight": 1.875,
                  "fontFamily": "$font-family-zen-kaku-gothic-new",
